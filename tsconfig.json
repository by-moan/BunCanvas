{
  "compilerOptions": {
    "types": ["bun"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "target": "ESNext",
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "rootDir": "./BunCanvas",
    "outDir": "./dist"
  },
  "include": ["./BunCanvas/**/*"],
  "exclude": [
    "CPPCanvas",
    "node_modules"
  ]
}